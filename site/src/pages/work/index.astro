---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';

const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const [lead, ...rest] = cases;
---
<BaseLayout
  title="Work"
  description="Case studies: agent pipeline observability, a national HIV/AIDS EMR, remote contract front-end work, encrypted chat, and a full-stack invoicing tool."
>
  <section class="head wrap">
    <h1 class="label">Work</h1>
  </section>

  <section class="list wrap">
    <div class="lead-slot">
      <CaseCard
        href={`/work/${lead.slug}`}
        title={lead.data.title}
        oneLiner={lead.data.oneLiner}
        metric={lead.data.headlineMetric}
        tags={lead.data.tags}
        headingLevel={2}
        lead
      />
    </div>

    <div class="cards">
      {rest.map((c) => (
        <CaseCard
          href={`/work/${c.slug}`}
          title={c.data.title}
          oneLiner={c.data.oneLiner}
          metric={c.data.headlineMetric}
          tags={c.data.tags}
          headingLevel={2}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .head { padding-block: var(--space-12) 0; }
  .list { padding-block: var(--space-6) var(--space-section); }
  .lead-slot { margin-bottom: var(--space-8); }

  .cards {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
