---
/**
 * The signature visual: an amber marker BESIDE a navy trace ID.
 *
 * This component exists so the amber rule cannot be broken by hand. Amber
 * is never the text and never a link; the ID itself is always navy, and
 * amber appears only as a dot, a left stripe, or the ground under dark
 * text on a pill. Any trace ID on this site goes through here.
 *
 *   dot    — an amber dot, then the ID. The default; use it inline.
 *   stripe — an amber left stripe with the ID beside it. For a block.
 *   pill   — dark ink on an amber ground. For a tag or a metric.
 */

interface Props {
  id: string;
  variant?: 'dot' | 'stripe' | 'pill';
  /** Screen-reader prefix, so a bare UUID is not read out of context. */
  label?: string;
  /**
   * Monospace suits an ID. A pill is usually carrying a phrase — a headline
   * metric or a tag — so it reads in the body face unless told otherwise.
   */
  mono?: boolean;
  class?: string;
}

const {
  id,
  variant = 'dot',
  label = 'trace ID',
  mono = variant !== 'pill',
  class: className = '',
} = Astro.props;
---

<span class:list={['trace-marker', variant, mono && 'mono', className]}>
  <span class="sr-only">{label}:</span>
  <code>{id}</code>
</span>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .trace-marker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 100%;
  }

  /* The ID. Navy, never amber. */
  .trace-marker code {
    color: var(--navy);
    font-family: inherit;
    font-size: 0.9375rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  /* An ID is monospace and may break anywhere; a phrase is neither. */
  .mono code {
    font-family: var(--font-mono);
    font-size: var(--size-code);
    line-height: var(--lh-code);
    word-break: break-all;
  }

  /* dot — amber sits beside the ID */
  .dot { align-items: baseline; }
  .dot::before {
    content: '';
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--amber);
    flex: none;
    transform: translateY(-2px);
  }

  /* stripe — amber runs down the left of the ID */
  .stripe {
    border-left: 3px solid var(--amber);
    padding: var(--space-1) 0 var(--space-1) var(--space-3);
    gap: 0;
  }

  /* pill — dark ink on an amber ground; the contrast is on the ground,
     not on the letters */
  .pill {
    background: var(--amber);
    color: #1a1206;
    padding: 3px var(--space-3);
    border-radius: 999px;
    gap: 0;
  }
  .pill code { color: #1a1206; font-size: 0.8125rem; font-weight: 500; }
  .pill.mono code { font-size: 0.8125rem; }
</style>
