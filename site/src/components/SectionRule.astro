---
/**
 * The 1px amber hairline between major sections. A rule is a mark, not
 * text — this is one of the three places amber is allowed.
 */
---
<hr class="section-rule" />

<style>
  .section-rule {
    border: 0;
    border-top: 1px solid var(--amber);
    margin: 0;
    opacity: 0.55;
  }
</style>
