---
import { site } from '../site';
---
<section class="proof" aria-label="Production credibility">
  <div class="wrap">
    <p class="label">In production</p>
    <p class="line">{site.proof}</p>
    <ul class="stack-row">
      {site.stack.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .proof {
    background: var(--surface);
    border-block: 1px solid var(--line);
    padding-block: var(--space-12);
  }
  .line {
    font-size: 1.0625rem;
    color: var(--navy);
    max-width: 58ch;
    margin-bottom: var(--space-6);
  }
  .stack-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    max-width: none;
    font-size: var(--size-label);
    line-height: var(--lh-label);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stack-row li { margin: 0; display: flex; align-items: center; gap: var(--space-4); }
  .stack-row li + li::before {
    content: '';
    inline-size: 4px;
    block-size: 4px;
    border-radius: 50%;
    background: var(--amber);
  }
</style>
