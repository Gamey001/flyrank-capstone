---
import { site, flyrank } from '../site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap inner">
    {flyrank.verifyUrl && (
      <a class="badge" href={flyrank.verifyUrl} target="_blank" rel="noopener noreferrer">
        <span class="dot" aria-hidden="true"></span>
        <span>{flyrank.label}</span>
        <span class="verb">{flyrank.verb}</span>
      </a>
    )}
    <p class="muted">
      {site.name} — {site.role}.
      <span class="nowrap">© {year}</span>
    </p>
    <p class="muted src">
      <a href={site.capstoneRepo} target="_blank" rel="noopener noreferrer">Source for this site and the capstone</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-6);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
    justify-content: space-between;
    font-size: 0.875rem;
  }
  .inner p { margin: 0; max-width: none; }
  .nowrap { white-space: nowrap; }
  .src { text-align: right; }
  @media (max-width: 560px) { .src { text-align: left; } }

  /* ---- Graduate badge -------------------------------------------------- */
  /* Takes its own line above the credit row. Amber is the dot only — the
     label and the link affordance stay navy. */
  .badge {
    flex-basis: 100%;
    inline-size: fit-content;
    max-inline-size: 100%;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--navy);
    text-decoration: none;
    font-size: 0.8125rem;
    line-height: 1.3;
    transition: border-color 120ms ease;
  }
  .badge:hover { border-color: var(--navy); }

  .dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--amber);
    flex: none;
  }

  .verb {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    flex: none;
  }
  .badge:hover .verb { color: var(--navy); text-decoration-thickness: 2px; }
</style>
