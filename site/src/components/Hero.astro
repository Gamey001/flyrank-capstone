---
import { Image } from 'astro:assets';

import { site } from '../site';
import portrait from '../assets/portrait-hero.png';

// The dial and its backdrop are part of the image itself, so the component
// draws no ring of its own.

// Faceted lower edge — deepest under the portrait, stepping up to the left.
const EDGE_FILL = 'M0 0H1440V30L1168 30L1094 92H906L852 50H566L506 24H0Z';
const EDGE_LINE = 'M0 24H506L566 50H852L906 92H1094L1168 30H1440';
---
<section class="hero">
  <div class="panel">
    <div class="wrap grid">
      <div class="copy">
        <p class="eyebrow">
          <span class="dot" aria-hidden="true"></span>{site.role} · Available for remote work
        </p>
        <h1>{site.claim}</h1>
        <p class="lede">{site.subline}</p>
        <p class="cta"><a href="#case-study">See the trace ↓</a></p>
      </div>

      <figure class="portrait">
        <Image
          class="shot"
          src={portrait}
          alt={`${site.name}, ${site.role}`}
          widths={[340, 510, 680]}
          sizes="(min-width: 900px) 380px, 320px"
          quality={92}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </div>

  <svg class="edge" viewBox="0 0 1440 92" preserveAspectRatio="none"
       aria-hidden="true" focusable="false">
    <path class="edge-fill" d={EDGE_FILL} />
    <path class="edge-line" d={EDGE_LINE} vector-effect="non-scaling-stroke" />
  </svg>
</section>

<style>
  /* Matched to the hero image's own backdrop (rgb 16,30,58) so the image
     rectangle has no edge against the panel. */
  .hero { padding-block: 0; --hero-ink: #101e3a; }

  .panel {
    position: relative;
    overflow: hidden;
    background: var(--hero-ink);
    color: var(--bg);
    padding-block: clamp(var(--space-8), 4.5vw, 60px) 0;
  }

  .grid { display: grid; row-gap: 0; }

  .copy { padding-bottom: clamp(var(--space-8), 4.5vw, 60px); }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--size-label);
    line-height: var(--lh-label);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(253, 253, 251, 0.62);
    margin: 0 0 var(--space-6);
  }
  .dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--amber);
    flex: none;
  }

  .hero h1 {
    color: var(--bg);
    font-size: clamp(2rem, 4.8vw, 2.75rem);
    max-width: 24ch;
  }
  .hero .lede {
    color: rgba(253, 253, 251, 0.72);
    max-width: 54ch;
  }
  .cta { margin-top: var(--space-8); margin-bottom: 0; font-weight: 500; }
  .cta a { color: var(--bg); }

  .portrait {
    position: relative;
    margin: 0 auto;
    max-width: 320px;
    align-self: end;
    display: flex;
    justify-content: center;
  }

  /* The image carries its own navy backdrop, matched to --surface-ink, so its
     edges disappear into the panel with no mask needed. */
  .shot {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
  }

  .edge {
    display: block;
    width: 100%;
    height: clamp(44px, 6.4vw, 92px);
  }
  .edge-fill { fill: var(--hero-ink); }
  .edge-line { fill: none; stroke: var(--amber); stroke-width: 1.5; opacity: 0.75; }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) 340px;
      column-gap: clamp(var(--space-8), 5vw, 72px);
      align-items: end;
    }
    .copy { grid-column: 1; align-self: center; }
    .portrait { grid-column: 2; max-width: 340px; margin: 0; }
  }
</style>
