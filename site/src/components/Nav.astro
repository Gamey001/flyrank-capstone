---
import { nav } from '../site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="site-nav">
  <div class="wrap inner">
    <a href="/" class="mark" aria-label="Home">
      <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path d="M5 22 L14 10 L27 10" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="5" cy="22" r="2.6" fill="currentColor" />
        <circle cx="14" cy="10" r="2.6" fill="currentColor" />
        <circle cx="27" cy="10" r="3.4" fill="#c8841f" />
      </svg>
    </a>
    <nav aria-label="Primary">
      <ul>
        {nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 64px;
  }
  .mark {
    display: inline-flex;
    color: var(--navy);
    text-decoration: none;
    padding: var(--space-2);
    margin-left: calc(var(--space-2) * -1);
  }
  nav ul {
    display: flex;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  nav li { margin: 0; }
  nav a {
    font-size: var(--size-label);
    line-height: var(--lh-label);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding-block: var(--space-2);
    display: inline-block;
  }
  nav a:hover { color: var(--navy); }
  /* Current page: navy text with a 1px amber underline beside it — the mark
     sits next to the word, never in it. */
  nav a[aria-current='page'] {
    color: var(--navy);
    box-shadow: inset 0 -2px 0 0 var(--amber);
  }
</style>
