# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM (the agent's model calls) ---
# Leave OPENAI_API_KEY empty to run the pipeline on the deterministic offline
# model instead. Every phase, including the crash demo, works without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LangSmith: the inside watcher ---
# Rides inside the process. Rich on the happy path, blind to a hard kill.
# That blindness is the point of this build, not a misconfiguration.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=flyrank-capstone
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379/0

# --- Sandbox: the sealed box the generated code runs in ---
SANDBOX_IMAGE=flyrank-sandbox:latest
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_TIMEOUT_SECONDS=60
